# IC Wallet environment template / IC 월렛 환경 템플릿
# Duplicate this file as `.env.local` (never commit secrets). / 이 파일을 `.env.local`로 복사하되 비밀 값은 커밋하지 마세요.

# --- Core services / 코어 서비스 ---
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# --- Database / 데이터베이스 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icwallet
DB_USER=icwallet_app
DB_PASSWORD=change_me
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# --- Redis / 레디스 ---
REDIS_URL=redis://localhost:6379
OTP_REDIS_DB=1

# --- External APIs / 외부 API ---
MBLOCK_API_BASE=https://agent.mblockapi.com/bsc
MBLOCK_API_KEY=replace_with_key
COINEX_API_BASE=https://api.coinex.com
COINEX_API_KEY=replace_with_coinex_key
COINEX_API_SECRET=replace_with_coinex_secret

# --- Test Flags / 테스트 플래그 ---
RUN_MBLOCK_TESTS=false
MBLOCK_TEST_KEY=
HASHDAM_API_BASE=https://hashdam.example.com
COUPON_PROVIDER_BASE=https://coupon.example.com

# --- Blockchain / 블록체인 ---
ISC_RPC_URL=https://chain.icastle.io/rpc
BNB_RPC_URL=https://bsc-dataseed.binance.org
CHAIN_DEFAULT_GAS_PRICE=5000000000

# --- Security / 보안 ---
JWT_SECRET=replace_with_strong_secret
TURNSTILE_SITE_KEY=replace_with_site_key
TURNSTILE_SECRET_KEY=replace_with_secret_key
ACCESS_TOKEN_SECRET=replace_with_access_secret
REFRESH_TOKEN_SECRET=replace_with_refresh_secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
WALLET_KEY_ENCRYPTION_SECRET=replace_with_32_char_secret

# --- Monitoring / 모니터링 ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOKI_URL=http://localhost:3100
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Admin / 관리자 ---
ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change_on_first_login

# End of template / 템플릿 끝
